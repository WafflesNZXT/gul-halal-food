{
  "name": "gul-halal-food",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/index.js --kill-others-on-fail \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:server": "node --watch --import tsx server/index.ts",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test server/tests/orders.test.ts src/contexts/cart.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx server/migrate.ts"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
