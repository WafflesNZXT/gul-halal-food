# Runtime PostgreSQL/Neon connection. Server-only: never use a VITE_ prefix.
# Local development normally uses DATABASE_URL. Vercel/Neon may provide POSTGRES_URL.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Optional direct/unpooled URL for deliberate schema migrations. Resolution:
# DATABASE_MIGRATION_URL, DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING,
# POSTGRES_URL_NO_SSL, DATABASE_URL, then POSTGRES_URL.
DATABASE_MIGRATION_URL=
POSTGRES_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=

# Optional public URL for generated status links and trusted-origin checks.
# Leave blank on Vercel to use the current deployment/request URL safely.
APP_BASE_URL=http://localhost:5173

# Local Express API port. Vite proxies /api to this same port.
API_PORT=5000

# Optional order-request rate-limit settings.
ORDER_RATE_LIMIT_WINDOW_MS=900000
ORDER_RATE_LIMIT_MAX=10

# Optional order-recovery lookup rate limits.
ORDER_LOOKUP_RATE_LIMIT_WINDOW_MS=900000
ORDER_LOOKUP_RATE_LIMIT_MAX=10

# Shared administrator credentials. These are server-only and must never use a VITE_ prefix.
# Generate the hash interactively with: npm run admin:hash-password
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-scrypt-v1-password-hash
# 1–168 hours; 12 is the safe default for a shared phone.
ADMIN_SESSION_TTL_HOURS=12

# Optional sign-in rate-limit settings.
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=5
