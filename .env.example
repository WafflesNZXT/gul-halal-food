# Required for persisted orders. Keep this server-only; never use a VITE_ prefix.
DATABASE_URL=postgresql://username:password@localhost:5432/gul_halal_food

# Optional public base URL used for production links and origin validation.
APP_BASE_URL=https://your-domain.example

# API port. In development Vite runs on PORT and proxies to this port.
API_PORT=5001

# Optional POST /api/orders rate-limit configuration.
ORDER_RATE_LIMIT_WINDOW_MS=900000
ORDER_RATE_LIMIT_MAX=10
